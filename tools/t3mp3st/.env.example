# Copy to tools/t3mp3st/.env (gitignored). Never commit the real file.
# Or set XAI_API_KEY in repo root .env (last line works).

XAI_API_KEY=

# Backbone (synced to ~/.t3mp3st/.env on configure)
LLM_PROVIDER=xai
LLM_MODEL=grok-4.5
XAI_REASONING_EFFORT=high

# cli-swarm overnight tuning
XAI_SWARM_ROUNDS=3
XAI_SWARM_CONCURRENCY=2
XAI_SWARM_BUDGET_MIN=240
XAI_SWARM_MAX_TOOL_ROUNDS=35
XAI_SWARM_MAX_FILE_BYTES=120000
# JSON squad override (default: 5 web-app specialists in overnight-swarm.mjs)
# XAI_SWARM_SQUAD=[{"class":"authz-bypass","count":1}]

# Scoped read roots for xAI repo tools (comma-separated)
XAI_SWARM_SCOPE_ROOTS=apps/server-pilot/src,apps/mail

# Optional: local server-pilot target for War Room (not cli-swarm)
ZERO_EC2_PILOT_TARGET_URL=http://127.0.0.1:8787
