#!/usr/bin/env sh
set -e
# Ship mode (owner 2026-11-18): lint staged JS/TS for errors only. Warnings never block a commit.
# oxlint 1.9 does not honor ignorePatterns in .oxlintrc.json; keep CLI ignore too.
changed=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
staged=$(echo "$changed" | grep -E '\.(cjs|cts|js|jsx|mjs|mts|ts|tsx)$' | grep -v '^external/' || true)
[ -n "$staged" ] || exit 0
echo "$staged" | xargs pnpm dlx oxlint@1.9.0 --ignore-pattern 'external/**'
