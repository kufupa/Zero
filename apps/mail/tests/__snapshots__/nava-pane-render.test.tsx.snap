      <main
        class="nava-pane-scroll flex min-h-0 flex-1 flex-col gap-3.5 overflow-y-auto p-3.5"
      >
        <section
          aria-label="Contact"
          class="shrink-0 overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
          id="quote-contact"
        >
          <div
            class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3 py-[9px]"
          >
            <h3
              class="flex items-center gap-1.5 text-[13px] font-bold text-[#475569]"
            >
              Contact
            </h3>
          </div>
          <div
            class="flex flex-col gap-3.5 p-3"
          >
            <dl
              class="grid grid-cols-2 gap-x-2.5 gap-y-2"
            >
              <div
                class="flex min-w-0 flex-col gap-0.5"
                data-contact-field="name"
              >
                <dt
                  class="text-[11.5px] font-semibold text-[#64748b]"
                >
                  Name
                </dt>
                <dd
                  class="flex min-w-0 items-start gap-1 text-[13px] text-[#1e293b]"
                  data-pii="true"
                >
                  <span
                    class="min-w-0 break-words"
                  >
                    David Miller
                  </span>
                </dd>
              </div>
              <div
                class="flex min-w-0 flex-col gap-0.5"
                data-contact-field="email"
              >
                <dt
                  class="text-[11.5px] font-semibold text-[#64748b]"
                >
                  Email
                </dt>
                <dd
                  class="flex min-w-0 items-start gap-1 text-[13px] text-[#1e293b]"
                  data-pii="true"
                >
                  <span
                    class="min-w-0 break-words"
                  >
                    guest@example.com
                  </span>
                </dd>
              </div>
              <div
                class="flex min-w-0 flex-col gap-0.5"
                data-contact-field="phone"
              >
                <dt
                  class="text-[11.5px] font-semibold text-[#64748b]"
                >
                  Phone
                </dt>
                <dd
                  class="flex min-w-0 items-start gap-1 text-[13px] text-[#1e293b]"
                  data-pii="true"
                >
                  <span
                    class="min-w-0 break-words"
                  >
                    —
                  </span>
                </dd>
              </div>
            </dl>
            <div
              class="flex flex-wrap items-center justify-between gap-2 border-t border-[#e2e8f0] pt-2"
            >
              <button
                aria-expanded="false"
                class="rounded-[3px] text-[12.5px] font-semibold text-[#0066cc] hover:underline"
                type="button"
              >
                Edit
              </button>
              <p
                class="text-[11.5px] text-[#64748b]"
              >
                Corrections save to this request only. HMS is not changed.
              </p>
            </div>
          </div>
        </section>
        <div
          class="flex flex-col gap-2"
        >
          <p
            class="text-[11px] text-slate-600"
          >
            Update the Outlook add-in to enable automatic email copying.
          </p>
        </div>
        <div
          class="flex flex-col gap-3"
        />
        <section
          aria-labelledby="amend-lookup-title"
          class="flex flex-col gap-3 rounded-sm border border-[#e2e8f0] bg-white px-3 py-3 text-[#1e293b]"
          data-testid="amend-lookup-panel"
          id="quote-booking"
        >
          <h3
            class="text-[13px] font-semibold text-[#1e293b]"
            id="amend-lookup-title"
          >
            Change to an existing booking
          </h3>
          <p
            class="text-[12.5px] text-[#1e293b]"
            data-pii="true"
            data-testid="amend-request-summary"
            title="Request from this email"
          >
            Add the night of 31 Oct
          </p>
          <div
            class="grid grid-cols-1 gap-3"
          >
            <div
              class="flex min-w-0 flex-col gap-2"
            >
              <p
                class="text-[10px] font-semibold uppercase tracking-wide text-[#64748b]"
              >
                Booking in HMS now
              </p>
              <dl
                class="grid grid-cols-2 gap-x-2.5 gap-y-1.5"
              >
                <div
                  class="flex min-w-0 flex-col gap-0.5"
                  data-field="confirmation"
                >
                  <dt
                    class="text-[10px] font-semibold uppercase tracking-wide text-[#64748b]"
                  >
                    Confirmation
                  </dt>
                  <dd
                    class="break-words text-[12.5px] text-[#1e293b]"
                    data-pii="true"
                    title="From the email"
                  >
                    57291630-1
                  </dd>
                </div>
              </dl>
              <span
                class="inline-flex flex-wrap items-center gap-x-3 gap-y-1"
              >
                <button
                  class="rounded-sm border border-[#0066cc] bg-white px-2.5 py-1 text-[11.5px] font-medium text-[#0066cc]"
                  type="button"
                >
                  Copy for HMS
                </button>
                <span
                  class="text-[11px] text-amber-900"
                  role="status"
                />
              </span>
              <p
                class="text-[11.5px] text-[#64748b]"
              >
                Looking up…
              </p>
            </div>
          </div>
          <div
            class="flex flex-col gap-2"
          >
            <button
              class="rounded-sm border border-[#0066cc] bg-white px-2.5 py-1.5 text-[11.5px] font-medium text-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8]"
              disabled=""
              type="button"
            >
              Find this booking in HMS
            </button>
            <p
              class="text-[10.5px] text-[#64748b]"
            >
              Takes about 1–2 minutes. Quotes wait while it runs.
            </p>
            <p
              class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 rounded-xs border border-[#e2e8f0] bg-white px-3 py-2 text-xs text-[#475569]"
              data-state="queued"
              data-testid="hms-job-status"
              role="status"
            >
              <span
                class="font-semibold text-[#1e293b]"
              >
                Looking up in HMS — you can keep working
              </span>
              <span
                class="font-semibold text-[#475569]"
              >
                Queued
              </span>
              <span>
                Nava is looking up the booking in HMS…
              </span>
              <span>
                0 s elapsed
              </span>
            </p>
            <div
              aria-live="polite"
            />
          </div>
          <div
            class="flex justify-end border-t border-[#e2e8f0] pt-2"
            data-testid="amend-run-placeholder"
          >
            <button
              class="rounded-sm border border-[#0066cc] bg-white px-2.5 py-1.5 text-[11.5px] font-medium text-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8]"
              disabled=""
              title="Find the booking first"
              type="button"
            >
              Preview
            </button>
          </div>
        </section>
        <div
          class="flex flex-col gap-2.5"
        >
          <button
            class="flex h-8 items-center justify-center gap-1.5 rounded-[3px] border border-[#0066cc] bg-white px-3 text-[13px] font-semibold text-[#0066cc] transition-colors hover:bg-[#eff6ff] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8] "
            type="button"
          >
            <svg
              class="lucide lucide-send h-3.5 w-3.5"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"
              />
              <path
                d="m21.854 2.147-10.94 10.939"
              />
            </svg>
            Insert draft in Outlook
          </button>
          <p
            class="text-[11px] text-[#64748b]"
          >
            Creates an unsent reply with the PDF attached. Review it, then Send manually in Outlook. Nava never sends from this pane.
          </p>
        </div>
      </main>
      <footer
        class="mt-auto flex shrink-0 items-center justify-end border-t border-[#f1f5f9] px-3 py-1.5"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="More"
          class="flex h-8 w-8 items-center justify-center rounded-xs text-[#64748b] hover:bg-[#f1f5f9] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0066cc]"
          data-state="closed"
          id="radix-stable"
          type="button"
        >
          <svg
            class="lucide lucide-ellipsis h-4 w-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle
              cx="12"
              cy="12"
              r="1"
            />
            <circle
              cx="19"
              cy="12"
              r="1"
            />
            <circle
              cx="5"
              cy="12"
              r="1"
            />
          </svg>
        </button>
      </footer>
    </div>
  </div>
</div>
`;

