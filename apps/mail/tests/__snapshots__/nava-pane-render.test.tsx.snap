                    class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                    id="quote-client-telephone"
                    value=""
                  />
                </div>
                <div
                  class="flex flex-col gap-1.5 border-t border-[#e2e8f0] pt-2"
                >
                  <label
                    class="flex flex-col gap-1 text-[12.5px] font-semibold text-[#475569]"
                  >
                    Dinner allowance (R per person per night)
                    <input
                      aria-label="Dinner allowance (R per person per night)"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                      inputmode="decimal"
                      value=""
                    />
                  </label>
                  <label
                    class="flex flex-col gap-1 text-[12.5px] text-[#64748b]"
                  >
                    Dinner label, optional (e.g. food only)
                    <input
                      aria-label="Dinner label"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                      maxlength="120"
                      value=""
                    />
                  </label>
                </div>
                <div
                  class="flex flex-col gap-1.5 border-t border-[#e2e8f0] pt-2"
                >
                  <label
                    class="flex flex-col gap-1 text-[12.5px] font-semibold text-[#475569]"
                  >
                    Lunch allowance (R per person per night)
                    <input
                      aria-label="Lunch allowance (R per person per night)"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                      inputmode="decimal"
                      value=""
                    />
                  </label>
                  <label
                    class="flex flex-col gap-1 text-[12.5px] text-[#64748b]"
                  >
                    Lunch label, optional (e.g. with 1 soft drink)
                    <input
                      aria-label="Lunch label"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                      maxlength="120"
                      value=""
                    />
                  </label>
                </div>
                <div
                  class="flex flex-col gap-1.5 border-t border-[#e2e8f0] pt-2"
                >
                  <label
                    class="flex flex-col gap-1 text-[12.5px] font-semibold text-[#475569]"
                  >
                    Office transfer (R per person per day)
                    <input
                      aria-label="Office transfer (R per person per day)"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                      inputmode="decimal"
                      value=""
                    />
                  </label>
                  <label
                    class="flex flex-col gap-1 text-[12.5px] text-[#64748b]"
                  >
                    Office transfer days, optional (blank = nights of stay)
                    <input
                      aria-label="Office transfer days"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                      inputmode="numeric"
                      placeholder="nights of stay"
                      value=""
                    />
                  </label>
                </div>
                <div
                  class="flex flex-col gap-1.5 border-t border-[#e2e8f0] pt-2"
                >
                  <label
                    class="flex items-center gap-2 text-[12.5px] font-semibold text-[#475569]"
                  >
                    <input
                      aria-label="Shuttle requested"
                      type="checkbox"
                    />
                    Shuttle requested
                  </label>
                </div>
                <div
                  aria-label="Other: label, amount, unit"
                  class="flex flex-col gap-1.5 border-t border-[#e2e8f0] pt-2"
                  role="group"
                >
                  <span
                    class="text-[12.5px] font-semibold text-[#475569]"
                  >
                    Other: label, amount, unit
                  </span>
                  <div
                    class="grid grid-cols-2 gap-2"
                  >
                    <label
                      class="flex flex-col gap-1 text-[11px] text-[#64748b]"
                    >
                      Label
                      <input
                        aria-label="Other label"
                        class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                        maxlength="120"
                        placeholder="e.g. Parking"
                        value=""
                      />
                    </label>
                    <label
                      class="flex flex-col gap-1 text-[11px] text-[#64748b]"
                    >
                      Amount (R)
                      <input
                        aria-label="Other amount"
                        class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                        inputmode="decimal"
                        value=""
                      />
                    </label>
                  </div>
                  <label
                    class="flex flex-col gap-1 text-[11px] text-[#64748b]"
                  >
                    Unit
                    <select
                      aria-label="Other unit"
                      class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b]"
                    >
                      <option
                        value="per_person_night"
                      >
                        R per person per night
                      </option>
                      <option
                        value="per_person"
                      >
                        R per person
                      </option>
                      <option
                        value="per_trip"
                      >
                        R per trip
                      </option>
                      <option
                        value="item"
                      >
                        R once (item)
                      </option>
                    </select>
                  </label>
                </div>
                <label
                  class="flex flex-col gap-1 border-t border-[#e2e8f0] pt-2 text-[12.5px] font-semibold text-[#475569]"
                >
                  Notes for the quote
                  <textarea
                    aria-label="Notes for the quote"
                    class="min-h-16 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 py-1.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] min-h-[3.5rem] font-normal"
                    maxlength="1000"
                  />
                  <span
                    class="text-[12.5px] font-normal text-[#64748b]"
                  >
                    Unpriced. Printed on the PDF and added to the reply as a note.
                  </span>
                </label>
              </div>
            </div>
          </details>
          <section
            aria-label="Search availability & room rates"
            class="shrink-0 overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
          >
            <div
              class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3 py-[9px]"
            >
              <h3
                class="flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.4px] text-[#475569]"
              >
                <span
                  class="flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[#1a4332] text-[10.5px] text-white"
                >
                  2
                </span>
                Search availability & room rates
              </h3>
            </div>
            <div
              class="flex flex-col gap-3.5 p-3"
            >
              <article
                class="flex flex-col gap-3 rounded-[4px] border border-[#cbd5e1] bg-white p-3"
              >
                <div
                  class="flex flex-col gap-0.5"
                >
                  <h4
                    class="text-[13px] font-bold text-[#1e293b]"
                  >
                    Availability for this date range
                  </h4>
                  <p
                    class="text-[12.5px] text-[#64748b]"
                  >
                    Separate HMS booking · one availability search for these dates.
                  </p>
                </div>
                <div
                  class="flex flex-col gap-1"
                >
                  <button
                    class="flex h-[38px] w-full items-center justify-center gap-2 rounded-[3px] text-[13px] font-bold text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:bg-[#cbd5e1] disabled:text-[#64748b]  bg-[#0066cc] hover:bg-[#0052a3]"
                    disabled=""
                    type="button"
                  >
                    Search availability
                  </button>
                  <p
                    class="text-center text-[12.5px] text-[#64748b]"
                  >
                    Add arrival and departure dates first.
                  </p>
                </div>
                <details
                  class="text-[12.5px] text-[#64748b]"
                >
                  <summary
                    class="w-fit cursor-pointer font-semibold text-[#0066cc]"
                  >
                    Details
                  </summary>
                  <div
                    class="mt-2 rounded-[3px] border border-[#e2e8f0] bg-[#f8fafc] p-2"
                  >
                    <div
                      class="flex flex-col gap-2"
                    >
                      <div
                        class="flex flex-col gap-1 border-t border-[#e2e8f0] pt-2 first:border-t-0 first:pt-0"
                      >
                        <div
                          class="flex items-center justify-between gap-2"
                        >
                          <span
                            class="text-[12px] font-semibold text-[#1e293b]"
                          >
                            Search availability unknown → unknown
                          </span>
                          <span
                            class="text-[10px] font-bold uppercase text-[#64748b]"
                          >
                            Ready
                          </span>
                        </div>
                        <p
                          class="text-[11px] text-[#64748b]"
                        >
                          Dates unknown → unknown · Room 1: 1 × any room, adults not set
                        </p>
                        <button
                          class="flex h-8 items-center justify-center gap-1.5 rounded-[3px] border border-[#0066cc] bg-white px-3 text-[13px] font-semibold text-[#0066cc] transition-colors hover:bg-[#eff6ff] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8] self-start"
                          type="button"
                        >
                          <span>
                            Run
                          </span>
                          <span>
                            Search availability unknown → unknown
                          </span>
                        </button>
                      </div>
                    </div>
                  </div>
                </details>
                <div
                  class="flex flex-col gap-2 border-t border-[#e2e8f0] pt-2.5"
                >
                  <h5
                    class="text-[12.5px] font-semibold text-[#475569]"
                  >
                    Room 1 rates
                  </h5>
                </div>
                <div
                  class="flex items-center justify-between gap-2 border-t border-[#e2e8f0] pt-2 text-[13px]"
                >
                  <span
                    class="font-semibold text-[#475569]"
                  >
                    Stay subtotal
                  </span>
                  <span
                    class="font-bold text-[#1e293b]"
                  >
                    Search availability to calculate
                  </span>
                </div>
              </article>
              <div
                class="flex flex-col gap-1"
              >
                <button
                  class="flex h-8 items-center justify-center gap-1.5 rounded-[3px] border border-[#0066cc] bg-white px-3 text-[13px] font-semibold text-[#0066cc] transition-colors hover:bg-[#eff6ff] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8] w-full"
                  type="button"
                >
                  + Add another date range
                </button>
                <p
                  class="text-center text-[12.5px] text-[#64748b]"
                >
                  Each date range creates a separate HMS booking.
                </p>
              </div>
              <div
                aria-label="Quotation total"
                class="flex flex-col gap-1 rounded-[4px] border border-[#cbd5e1] bg-[#f8fafc] p-3"
              >
                <div
                  class="flex flex-wrap items-center justify-between gap-2"
                >
                  <h3
                    class="text-[13px] font-bold text-[#1e293b]"
                  >
                    Quotation total (all stays)
                  </h3>
                  <span
                    class="text-[14px] font-extrabold text-[#1e293b]"
                  >
                    Not ready
                  </span>
                </div>
                <p
                  class="text-[12.5px] text-[#64748b]"
                >
                  0 of 1 stays rated. Search each date range for the complete total.
                </p>
              </div>
            </div>
          </section>
          <section
            aria-label="Quote documents"
            class="shrink-0 overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
          >
            <div
              class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3 py-[9px]"
            >
              <h3
                class="flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.4px] text-[#475569]"
              >
                <span
                  class="flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[#1a4332] text-[10.5px] text-white"
                >
                  3
                </span>
                Quote documents
              </h3>
            </div>
            <div
              class="flex flex-col gap-3.5 p-3"
            >
              <div
                class="flex flex-col gap-3.5"
              >
                <div
                  class="flex flex-col gap-1"
                >
                  <button
                    class="flex h-[38px] w-full items-center justify-center gap-2 rounded-[3px] text-[13px] font-bold text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:bg-[#cbd5e1] disabled:text-[#64748b]  bg-[#0066cc] hover:bg-[#0052a3]"
                    disabled=""
                    type="button"
                  >
                    Prepare PDF
                  </button>
                  <p
                    class="text-center text-[12.5px] text-[#64748b]"
                  >
                    Get rates first.
                  </p>
                </div>
                <div
                  class="flex flex-col gap-1.5"
                >
                  <button
                    class="flex h-8 items-center justify-center gap-1.5 rounded-[3px] border border-[#0066cc] bg-white px-3 text-[13px] font-semibold text-[#0066cc] transition-colors hover:bg-[#eff6ff] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8] w-full"
                    disabled=""
                    type="button"
                  >
                    Download Excel
                  </button>
                  <p
                    class="text-center text-[12.5px] text-[#64748b]"
                  >
                    Excel needs the same checks as the PDF.
                  </p>
                </div>
                <div
                  class="flex flex-col gap-1"
                >
                  <button
                    class="flex h-8 items-center justify-center gap-1.5 rounded-[3px] border border-[#0066cc] bg-white px-3 text-[13px] font-semibold text-[#0066cc] transition-colors hover:bg-[#eff6ff] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:border-[#cbd5e1] disabled:text-[#94a3b8] w-full"
                    disabled=""
                    type="button"
                  >
                    Book in HMS
                  </button>
                  <p
                    class="text-center text-[11px] text-[#64748b]"
                  >
                    Coming soon
                  </p>
                </div>
                <div
                  class="flex flex-col gap-1"
                >
                  <div
                    class="flex items-center justify-between text-[13px] font-semibold text-[#475569]"
                  >
                    <label
                      class="flex items-center gap-1.5"
                      for="quote-reviewed-reply"
                    >
                      <span>
                        Reply to the client (you can edit it)
                      </span>
                    </label>
                  </div>
                  <textarea
                    aria-label="Reviewed reply"
                    class="min-h-28 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 py-1.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc]"
                    id="quote-reviewed-reply"
                  />
                </div>
              </div>
            </div>
          </section>
        </div>
        <section
          aria-label="Reply"
          class="shrink-0 overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
        >
          <div
            class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3 py-[9px]"
          >
            <h3
              class="flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.4px] text-[#475569]"
            >
              <span
                class="flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[#1a4332] text-[10.5px] text-white"
              >
                4
              </span>
              Reply
            </h3>
          </div>
          <div
            class="flex flex-col gap-3.5 p-3"
          >
            <div
              class="flex flex-col gap-1"
            >
              <button
                class="flex h-[38px] w-full items-center justify-center gap-2 rounded-[3px] text-[13px] font-bold text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:bg-[#cbd5e1] disabled:text-[#64748b]  bg-[#1a4332] hover:bg-[#143528]"
                disabled=""
                type="button"
              >
                <svg
                  class="lucide lucide-send h-3.5 w-3.5"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"
                  />
                  <path
                    d="m21.854 2.147-10.94 10.939"
                  />
                </svg>
                Draft quotation into email reply
              </button>
              <p
                class="text-center text-[12.5px] text-[#64748b]"
              >
                Prepare the quote PDF first
              </p>
            </div>
            <p
              class="text-[11px] text-[#64748b]"
            >
              Creates an unsent reply with the PDF attached. Review it, then Send manually in Outlook. Nava never sends from this pane.
            </p>
          </div>
        </section>
        <div
          class="flex flex-col gap-1.5 rounded-sm border border-[#e2e8f0] bg-[#f8fafc] p-3 text-xs"
          id="system-check-results"
        >
          <p
            class="text-[11px] font-bold uppercase tracking-wider text-[#64748b]"
          >
            System check results
          </p>
          <div
            class="flex items-center justify-between text-[#1e293b]"
          >
            <span>
              1. Outlook add-in connected
            </span>
            <svg
              class="lucide lucide-circle-alert h-4 w-4 text-rose-500"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
              />
              <line
                x1="12"
                x2="12"
                y1="8"
                y2="12"
              />
              <line
                x1="12"
                x2="12.01"
                y1="16"
                y2="16"
              />
            </svg>
          </div>
          <div
            class="flex items-center justify-between text-[#1e293b]"
          >
            <span>
              2. Selected email readable
            </span>
            <svg
              class="lucide lucide-circle-check h-4 w-4 text-emerald-600"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
              />
              <path
                d="m9 12 2 2 4-4"
              />
            </svg>
          </div>
          <div
            class="flex items-center justify-between text-[#1e293b]"
          >
            <span>
              3. Outlook folders readable
            </span>
            <svg
              class="lucide lucide-circle-alert h-4 w-4 text-rose-500"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
              />
              <line
                x1="12"
                x2="12"
                y1="8"
                y2="12"
              />
              <line
                x1="12"
                x2="12.01"
                y1="16"
                y2="16"
              />
            </svg>
          </div>
          <div
            class="flex items-center justify-between text-[#1e293b]"
          >
            <span>
              4. Nava server reachable
            </span>
            <svg
              class="lucide lucide-circle-check h-4 w-4 text-emerald-600"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
              />
              <path
                d="m9 12 2 2 4-4"
              />
            </svg>
          </div>
        </div>
      </main>
      <footer
        class="mt-auto flex shrink-0 items-center justify-end border-t border-[#f1f5f9] px-3 py-1.5"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="More"
          class="flex h-8 w-8 items-center justify-center rounded-xs text-[#64748b] hover:bg-[#f1f5f9] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0066cc]"
          data-state="closed"
          id="radix-«r5d»"
          type="button"
        >
          <svg
            class="lucide lucide-ellipsis h-4 w-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
