        >
          Sep 17, 2026, 12:00 PM
        </time>
      </section>
      <div
        class="mx-3 mt-2 shrink-0"
      >
        <section
          aria-label="Nava reads this as: Amendment"
          class="flex shrink-0 flex-col gap-2 rounded-[4px] border border-[#bfdbfe] bg-[#eff6ff] px-3 py-2.5"
          role="status"
        >
          <div
            class="flex flex-wrap items-center justify-between gap-2"
          >
