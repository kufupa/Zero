  >
    <div
      class="shadow-xs relative flex h-full w-full min-w-[320px] flex-col border-x border-[#cbd5e1] bg-white text-[#1e293b]"
    >
      <header
        aria-label="Nava mailbox"
        class="shrink-0 border-b border-[#e2e8f0] bg-white"
      >
        <div
          class="flex h-10 min-w-0 items-center justify-between gap-2 px-3.5"
        >
          <div
            class="flex min-w-0 items-center gap-2"
          >
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-[3px] bg-[#1a4332] text-[11px] font-extrabold text-white"
            >
              N
            </span>
            <h1
              class="truncate whitespace-nowrap text-[13px] font-bold text-[#1e293b]"
            >
              Nava Reservationist
            </h1>
          </div>
        </div>
        <div
          class="flex h-8 min-w-0 items-center gap-1.5 border-t border-[#f1f5f9] bg-[#f8fafc] px-3.5 text-[11px] font-medium text-[#475569]"
        >
          <span
            aria-hidden="true"
            class="h-2 w-2 shrink-0 rounded-full animate-pulse bg-emerald-600"
          />
          <span
            aria-label="Connected mailbox: ropperman@legacyhotels.co.za"
            class="min-w-0 flex-1 truncate font-semibold"
            title="ropperman@legacyhotels.co.za"
          >
            ropperman@legacyhotels.co.za
          </span>
          <span
            class="flex shrink-0 items-center gap-1.5 [&_button]:whitespace-nowrap"
          >
            <span
              class="whitespace-nowrap rounded-full bg-[#eff6ff] px-2 py-1 text-[10.5px] font-semibold text-[#0066cc]"
              data-testid="hms-running-count"
            >
              HMS: 1 pending
            </span>
            <span
              class="max-w-[130px] truncate"
            >
              Checking sync access
            </span>
          </span>
          <span
            class="sr-only"
          >
            Connected to Classic Outlook (16.0; product/build unknown)
          </span>
        </div>
      </header>
      <section
        aria-label="Selected email"
        class="mx-3 mt-2 flex shrink-0 items-start gap-2 rounded-[4px] border border-[#e2e8f0] bg-white px-2.5 py-2"
        id="quote-selected-message"
      >
        <svg
          class="lucide lucide-mail mt-0.5 h-3.5 w-3.5 shrink-0 text-[#64748b]"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            height="16"
            rx="2"
            width="20"
            x="2"
            y="4"
          />
          <path
            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
          />
        </svg>
        <div
          class="flex min-w-0 flex-1 flex-col gap-0.5"
        >
          <span
            class="truncate text-[11.5px] font-semibold text-[#475569]"
            data-pii="true"
          >
            David Miller &lt;guest@example.com&gt;
          </span>
          <span
            class="truncate text-[13px] font-bold text-[#1e293b]"
            data-pii="true"
          >
            Suite Availability Request
          </span>
        </div>
        <time
          class="shrink-0 pt-0.5 text-right text-[10.5px] text-[#64748b]"
