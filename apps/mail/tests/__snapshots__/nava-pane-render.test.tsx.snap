          >
            <div
              class="flex flex-col gap-1"
            >
              <button
                class="flex h-[38px] w-full items-center justify-center gap-2 rounded-[3px] text-[13px] font-bold text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc] disabled:cursor-not-allowed disabled:bg-[#cbd5e1] disabled:text-[#64748b] bg-[#1a4332] hover:bg-[#143528]"
                disabled=""
                type="button"
              >
                <svg
