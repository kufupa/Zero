                      </span>
                    </label>
                  </div>
                  <textarea
                    aria-label="Reviewed reply"
                    class="min-h-28 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 py-1.5 text-[12.5px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc]"
                    id="quote-reviewed-reply"
                  />
                </div>
              </div>
            </div>
          </section>
        </div>
        <section
          aria-label="Reply"
          class="overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
        >
          <div
            class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3 py-[9px]"
          >
