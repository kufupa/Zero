                </svg>
                Insert draft in Outlook
              </button>
              <p
                class="text-center text-[11px] text-[#64748b]"
              >
                Prepare the quote PDF first
              </p>
            </div>
            <p
              class="text-[11px] text-[#64748b]"
            >
              Creates an unsent reply with the PDF attached. Review it, then Send manually in Outlook. Nava never sends from this pane.
            </p>
          </div>
        </section>
      </main>
      <footer
        class="mt-auto flex shrink-0 items-center justify-end border-t border-[#f1f5f9] px-3 py-1.5"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="More"
          class="flex h-8 w-8 items-center justify-center rounded-xs text-[#64748b] hover:bg-[#f1f5f9] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0066cc]"
          data-state="closed"
