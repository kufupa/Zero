                    >
                      <option
                        value="per_person_night"
                      >
                        R per person per night
                      </option>
                      <option
                        value="per_person"
                      >
                        R per person
                      </option>
                      <option
                        value="per_trip"
                      >
                        R per trip
                      </option>
                      <option
                        value="item"
                      >
                        R once (item)
                      </option>
                    </select>
                  </label>
                </div>
                <label
                  class="flex flex-col gap-1 border-t border-[#e2e8f0] pt-2 text-[12.5px] font-semibold text-[#475569]"
