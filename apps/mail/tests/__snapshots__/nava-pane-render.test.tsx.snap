`;

exports[`NavaPane screen states > voucher: an unreadable PDF keeps the card without a missing-guest or partial-read note of its own 1`] = `
<div>
  <div
    class="flex h-screen w-full justify-center overflow-hidden bg-[#f1f3f6] font-['Segoe_UI',system-ui,sans-serif] text-sm"
  >
    <div
      class="shadow-xs relative flex h-full w-full min-w-[320px] flex-col border-x border-[#cbd5e1] bg-white text-[#1e293b]"
    >
      <header
        class="flex h-11 shrink-0 items-center justify-between gap-2 border-b border-[#e2e8f0] bg-white px-3.5"
      >
        <div
          class="flex min-w-0 shrink-0 items-center gap-2"
        >
          <span
            class="flex h-5 w-5 items-center justify-center rounded-[3px] bg-[#1a4332] text-[11px] font-extrabold text-white"
          >
            N
          </span>
          <h1
            class="min-w-0 truncate whitespace-nowrap text-[13px] font-bold text-[#1e293b]"
          >
            Nava Reservationist
          </h1>
          <button
            aria-label="Needs you"
            class="max-w-[96px] shrink-0 truncate whitespace-nowrap text-[11.5px] font-semibold text-[#0066cc] underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0066cc]"
            title="Needs you"
            type="button"
          >
            Needs you
          </button>
        </div>
        <div
          class="flex min-w-0 shrink items-center gap-1.5 text-[11.5px] font-medium text-[#475569] [&_button]:whitespace-nowrap"
        >
          <span
            class="h-2 w-2 rounded-full animate-pulse bg-emerald-600"
          />
          <span>
            Centurion
          </span>
          <span
            class="sr-only"
          >
            Connected to Classic Outlook (16.0; product/build unknown)
          </span>
        </div>
      </header>
      <p
        class="mx-3 mt-2 text-[11px] text-slate-600"
      >
        Update the Outlook add-in to enable automatic email copying.
      </p>
      <main
        class="nava-pane-scroll flex min-h-0 flex-1 flex-col gap-3.5 overflow-y-auto p-3.5"
      >
        <section
          aria-label="Contact"
          class="shrink-0 overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
          id="quote-contact"
        >
          <div
            class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3 py-[9px]"
          >
            <h3
              class="flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.4px] text-[#475569]"
            >
              Contact
            </h3>
          </div>
          <div
            class="flex flex-col gap-3.5 p-3"
          >
            <div
              class="grid grid-cols-2 gap-x-2.5 gap-y-2"
            >
              <div
                class="flex flex-col gap-1"
              >
                <div
                  class="flex items-center justify-between text-[13px] font-semibold text-[#475569]"
                >
                  <label
                    class="flex items-center gap-1.5"
                    for="quote-contact-name"
                  >
                    <span>
                      Name
                    </span>
                  </label>
                </div>
                <div
                  class="flex min-w-0 gap-1"
                >
                  <input
                    class="h-8 w-full rounded-[3px] border border-[#cbd5e1] bg-white px-2.5 text-[13px] text-[#1e293b] outline-none transition-colors focus:border-[#0066cc] disabled:bg-[#f8fafc] disabled:text-[#64748b] min-w-0"
                    data-pii="true"
                    id="quote-contact-name"
                    maxlength="200"
                    value="David Miller"
                  />
                  <button
                    aria-label="Copy name"
                    class="h-8 shrink-0 rounded-[3px] border border-[#cbd5e1] px-1.5 text-[10px] font-medium text-[#0066cc] disabled:cursor-not-allowed disabled:text-[#94a3b8]"
                    type="button"
                  >
