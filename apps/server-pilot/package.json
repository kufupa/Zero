{
  "name": "@zero/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./trpc": "./src/trpc/index.ts",
    "./auth": "./src/lib/auth.ts",
    "./auth-providers": "./src/lib/auth-providers.ts",
    "./schemas": "./src/lib/schemas.ts",
    "./driver/types": "./src/lib/driver/types.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/mail/ingest/worker.js",
    "test": "vitest run",
    "db:generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs migrate",
    "seed:prod": "tsx scripts/seed-prod.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "postgres": "3.4.5",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "catalog:",
    "react": "catalog:",
    "tsx": "4.20.5",
    "typescript": "catalog:",
    "vitest": "3.2.4"
  }
}

