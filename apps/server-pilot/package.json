{
  "name": "@zero/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./trpc": "./src/trpc/index.ts",
    "./auth": "./src/lib/auth.ts",
    "./auth-providers": "./src/lib/auth-providers.ts",
    "./schemas": "./src/lib/schemas.ts",
    "./driver/types": "./src/lib/driver/types.ts",
    "./outlook-sync-contracts": "./src/outlook-sync/contracts.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/mail/ingest/worker.js",
    "ai-worker": "node dist/ai/worker.js",
    "ai:test": "tsx src/ai/eval-runner.ts",
    "test:ai": "vitest run ai- bedrock-adapter-contract centurion-live-corpus-contract",
    "eval:ci": "tsx src/ai/eval-runner.ts --mode=spike",
    "eval": "tsx src/ai/eval-runner.ts --mode=spike",
    "eval:dev": "tsx src/ai/eval-runner.ts --mode=spike",
    "eval:hms-shadow": "tsx src/ai/eval-runner.ts --mode=hms-shadow --denominators=evals/hms/denominators.v1.json",
    "eval:hms-portfolio-ablation": "tsx src/ops/portfolio-ablation-replay.ts",
    "eval:quote-outcomes": "tsx scripts/quote-outcome-eval.ts",
    "eval:party": "tsx scripts/party-match-eval.ts",
    "eval:gold-pair-join": "tsx scripts/join-gold-pair-ops.ts",
    "eval:same-move": "tsx scripts/eval-same-move-promptfoo.ts",
    "test": "vitest run",
    "check:entities": "node scripts/check-entity-literals.mjs",
    "check:agent-finish": "tsx scripts/agent-finish-check.ts",
    "test:outlook-sync": "tsx scripts/outlook-sync-test-gate.ts",
    "test:ingestion": "INGESTION_DB_TEST_REQUIRED=1 vitest run --maxWorkers=1 tests/ingest-schema-drift.test.ts tests/pop3-worker.test.ts tests/recover-parse-failure.test.ts tests/migration-compatibility.test.ts",
    "test:rocketseed": "vitest run tests/transport-mode.test.ts tests/fixture-loopback.test.ts tests/worker-mode.test.ts tests/rocketseed-returned-copy.test.ts tests/rocketseed-returned-copy-correlation.test.ts tests/cid-images.test.ts tests/ingest-duplicate-cleanup.test.ts tests/sanitize-email-html.test.ts tests/safe-inline-image.test.ts tests/inline-attachment-http.test.ts tests/rocketseed-flow.test.ts tests/rocketseed-ci-contract.test.ts",
    "db:generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs migrate",
    "seed:prod": "tsx scripts/seed-prod.ts",
    "provision:prod": "tsx scripts/provision-prod.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.80",
    "@aws-sdk/client-bedrock-runtime": "3.1080.0",
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/client-secrets-manager": "^3.1077.0",
    "@aws-sdk/credential-provider-node": "3.972.63",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@hono/node-server": "^1.14.1",
    "@mastra/core": "1.70.0",
    "@mastra/libsql": "1.23.2",
    "@office-kit/xlsx": "0.25.0",
    "@smithy/signature-v4": "5.6.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "cheerio": "1.1.0",
    "drizzle-orm": "catalog:",
    "fflate": "0.8.2",
    "hono": "catalog:",
    "mailparser": "^3.9.12",
    "nodemailer": "^7.0.5",
    "playwright": "1.63.0",
    "postgres": "3.4.5",
    "sanitize-html": "^2.17.0",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@firecrawl/pdf-inspector": "1.25.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "catalog:",
    "@types/sanitize-html": "2.13.0",
    "drizzle-kit": "catalog:",
    "promptfoo": "0.124.1",
    "react": "catalog:",
    "tsx": "4.20.5",
    "typescript": "catalog:",
    "vitest": "3.2.4"
  }
}
