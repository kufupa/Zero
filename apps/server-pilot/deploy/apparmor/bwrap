# AppArmor profile for /usr/bin/bwrap (the PDF reader's sandbox, see src/mail/artifacts/read-artifact.ts).
# Ubuntu 24.04 sets kernel.apparmor_restrict_unprivileged_userns=1, so an unconfined service (pm2's systemd unit)
# cannot create the user namespace bubblewrap needs: every sandboxed pdfinfo/pdftotext exits 1 with
# "bwrap: setting up uid map: Permission denied". This grants userns to bwrap alone; never lift the restriction globally.
# Install: sudo install -m 0644 apps/server-pilot/deploy/apparmor/bwrap /etc/apparmor.d/bwrap
#          sudo apparmor_parser -r /etc/apparmor.d/bwrap
# Check:   sudo systemd-run --quiet --uid=ubuntu --pipe --wait --collect bash apps/server-pilot/deploy/pdf-text-gate.sh
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
